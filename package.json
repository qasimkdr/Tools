{
  "name": "solvepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/publish-scheduled.mjs && node scripts/check-schedule.mjs",
    "build": "next build",
    "start": "npx serve out",
    "lint": "node scripts/publish-scheduled.mjs && rm -rf .next/types && tsc --noEmit",
    "schedule": "node scripts/schedule.mjs",
    "roadmap": "python3 -I scripts/build-roadmap.py",
    "test:e2e": "playwright test",
    "seo:serp": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seo/serp.mjs",
    "seo:scrape": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seo/scrape.mjs",
    "seo:report": "node scripts/seo/report.mjs",
    "seo:research": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seo/research.mjs",
    "seo:record": "node scripts/seo/serp-record.mjs",
    "seo:check": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seo/browser-check.mjs",
    "seo:batch": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seo/batch.mjs",
    "roadmap:overlap": "python3 -I scripts/check-overlap.py",
    "tools:count": "node scripts/count-tools.mjs",
    "seo:self": "node scripts/seo/self-score.mjs"
  },
  "dependencies": {
    "mathjs": "15.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
